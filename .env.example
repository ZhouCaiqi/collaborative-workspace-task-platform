# 1. 本机开发数据库
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/task_management_db

# 2. pytest 测试数据库
TEST_DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/task_management_test_db
# 仅在确认上述数据库可随时清空后改为 true
TEST_DATABASE_RESET_ALLOWED=false

# 3. Docker 里的 MySQL 初始化参数
MYSQL_ROOT_PASSWORD=your_password
MYSQL_DATABASE=task_management_db
MYSQL_USER=task_user
MYSQL_PASSWORD=your_password

# JWT / Token
SECRET_KEY=replace-with-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis / fixed-window rate limiting
# Local development default. Compose overrides the host with its internal
# redis service name and does not publish Redis to the host.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1
RATE_LIMIT_KEY_PREFIX=task-api:rate-limit:v1
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_LIMIT=3
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_WRITE_LIMIT=60
RATE_LIMIT_WRITE_WINDOW_SECONDS=60
# Authentication endpoints are deliberately fail-closed; authenticated writes
# are deliberately fail-open when Redis is unavailable.
RATE_LIMIT_AUTH_FAILURE_POLICY=closed
RATE_LIMIT_WRITE_FAILURE_POLICY=open
